{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": [],
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci --omit=dev || npm install --omit=dev"
      ]
